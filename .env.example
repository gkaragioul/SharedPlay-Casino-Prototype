# ---------------------------------------------------------------------------
# SharedPlay Casino - environment
#
# The prototype is DEMO CREDITS ONLY. There are no payment, KYC or AML
# integrations anywhere in this codebase.
# ---------------------------------------------------------------------------

# Prisma / SQLite. The runtime resolves the database file to an absolute path
# automatically (see packages/db/src/client.ts), so this is mainly used by the
# Prisma CLI for migrations. Relative paths are resolved from the schema folder.
DATABASE_URL="file:./dev.db"

# Auth.js. Generate with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Game randomness.
#   random -> crypto-seeded, real gameplay
#   seeded -> deterministic, for tests and scripted investor runs
RNG_MODE="random"
RNG_SEED=""

# Custom server port
PORT="3000"
HOSTNAME="localhost"

# Public realtime endpoint (leave blank to use the same origin)
NEXT_PUBLIC_SOCKET_URL=""
